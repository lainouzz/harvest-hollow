--- !u!114 &963223208557431141
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3608858439817922025}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 7cb52339456216c4d8a38c29aac04e08, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  panel: {fileID: 0}
  label: {fileID: 0}
  nextKey: 2
  startDelay: 1.5
  fadeTime: 0.4
  gapBetweenHints: 0.4
  hints:
  - message: 'Welcome to Harvest Hollow!

      WASD to move, mouse to look, Space
      to jump.

      (Enter: next tip)'
    duration: 6
  - message: Press 1-5 to switch what you're holding, and left-click to use it.
    duration: 6
  - message: With the hoe, click an empty plot to lay soil, then click it again to
      till it.
    duration: 6
  - message: Water tilled soil before planting. Seeds in wet soil grow faster and
      give more.
    duration: 6
  - message: Press Tab to open your inventory and click a seed to pick it, then plant
      it with the seed bag.
    duration: 6
  - message: Harvest ripe crops with the harvest tool. Walk up to the merchant's
      truck to sell them and buy seeds.
    duration: 6
  - message: Look at a plot with a price over it and press B to buy it.
    duration: 6
  - message: Press X on a fence to open a path through it.
    duration: 6
  - message: Walk into the sleep spot to end the day. Crops grow overnight and your
      game is saved.
    duration: 6
